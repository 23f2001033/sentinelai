# --- Planner ---------------------------------------------------------------
# Which LLM plans the agent's actions.
#   groq       free tier, no card required  -> https://console.groq.com/keys
#   openrouter free models available        -> https://openrouter.ai/keys
#   together   free credits                 -> https://api.together.ai/settings/api-keys
#   ollama     fully local, no key needed   -> https://ollama.com/download
#   openai     paid                         -> https://platform.openai.com/api-keys
#   anthropic  paid                         -> https://console.anthropic.com/settings/keys
LLM_PROVIDER=groq

# Set the key for the provider you chose. Only one is needed.
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: override the provider's default model.
#   groq       llama-3.3-70b-versatile (default), llama-3.1-8b-instant, openai/gpt-oss-120b
#   openrouter meta-llama/llama-3.3-70b-instruct:free (default)
#   anthropic  claude-opus-5 (default)
# PLANNER_MODEL=

# Optional: point at any other OpenAI-compatible endpoint.
# LLM_BASE_URL=
# LLM_API_KEY=

# --- Runtime ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
MAX_STEPS_PER_RUN=25
BROWSER_HEADLESS=true
CORS_ORIGINS=*
